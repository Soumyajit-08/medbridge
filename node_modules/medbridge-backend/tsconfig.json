{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
   "moduleResolution": "node",
   
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "noImplicitAny": false
  },
  "include": ["src"]
}
