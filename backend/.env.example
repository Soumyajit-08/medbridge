# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=MedBridge
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
PORT=8000

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_ACCESS_SECRET=change-me-generate-a-strong-random-secret-here
JWT_REFRESH_SECRET=change-me-generate-a-different-strong-random-secret-here
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://medbridge_user:medbridge_pass@localhost:5432/medbridge

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── SMTP Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@medbridge.app
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=MedBridge <noreply@medbridge.app>
SMTP_TLS=true

# ── S3-Compatible Storage ─────────────────────────────────────────────────────
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_BUCKET=medbridge-uploads
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_REGION=ap-south-1
# Set to "local" for development (saves files to ./uploads/)
STORAGE_BACKEND=local

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png
